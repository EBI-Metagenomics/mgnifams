CREATE TABLE mgnifam (
    id INTEGER PRIMARY KEY,
    full_size INTEGER,
    seed_size INTEGER,
    converged BOOLEAN,
    protein_rep INTEGER,
    rep_region TEXT,
    rep_length INTEGER,
    rep_sequence TEXT,
    consensus TEXT,
    hmm_length INTEGER,
    plddt REAL,
    ptm REAL,
    helix_percent REAL,
    strand_percent REAL,
    coil_percent REAL,
    inside_percent REAL,
    membrane_alpha_percent REAL,
    outside_percent REAL,
    signal_percent REAL,
    membrane_beta_percent REAL,
    periplasm_percent REAL,
    -- Provenance of the release's families.tsv.gz (bin/load_families_tsv.py); not_updated_reason NULL unless not_updated
    status TEXT, -- new, updated or not_updated
    not_updated_reason TEXT,
    first_release TEXT,
    model_release TEXT,
    model_proteins_release TEXT,
    members_release TEXT,
    members_proteins_release TEXT,
    has_pfam INTEGER NOT NULL DEFAULT 0,
    has_funfam INTEGER NOT NULL DEFAULT 0,
    has_model_pfam INTEGER NOT NULL DEFAULT 0,
    has_structure INTEGER NOT NULL DEFAULT 0,
    seed_msa_blob BLOB DEFAULT NULL,
    hmm_blob BLOB DEFAULT NULL,
    rf_blob BLOB DEFAULT NULL,
    cif_blob BLOB DEFAULT NULL,
    biome_blob BLOB DEFAULT NULL,
    domain_blob BLOB DEFAULT NULL,
    s4pred_blob BLOB DEFAULT NULL,
    tm_blob BLOB DEFAULT NULL
);

CREATE TABLE mgnifam_pfams (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mgnifam_id INTEGER REFERENCES mgnifam(id),
    pfam TEXT,
    name TEXT,
    e_value REAL,
    score REAL,
    hmm_from INTEGER,
    hmm_to INTEGER,
    ali_from INTEGER,
    ali_to INTEGER,
    env_from INTEGER,
    env_to INTEGER,
    acc REAL
);

CREATE TABLE mgnifam_funfams (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mgnifam_id INTEGER REFERENCES mgnifam(id),
    funfam TEXT,
    e_value REAL,
    score REAL,
    hmm_from INTEGER,
    hmm_to INTEGER,
    ali_from INTEGER,
    ali_to INTEGER,
    env_from INTEGER,
    env_to INTEGER,
    acc REAL
);

CREATE TABLE mgnifam_folds (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mgnifam_id INTEGER REFERENCES mgnifam(id),
    fold TEXT,
    aligned_length INTEGER,
    q_start INTEGER,
    q_end INTEGER,
    t_start INTEGER,
    t_end INTEGER,
    e_value REAL,
    aln_tmscore REAL,
    q_tmscore REAL,
    t_tmscore REAL
);

CREATE TABLE mgnifam_model_pfams (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mgnifam_id INTEGER REFERENCES mgnifam(id),
    pfam TEXT,
    name TEXT,
    description TEXT,
    prob REAL,
    e_value REAL,
    length INTEGER,
    query_hmm TEXT,
    template_hmm TEXT
);
-- One row per MGnifams release this DB holds; merge_update_delta.sql adds the update releases (same DDL there)
CREATE TABLE release_history (
    release TEXT PRIMARY KEY NOT NULL, -- MGnifams release, MAJOR.MINOR
    date TEXT NOT NULL, -- YYYY-MM-DD
    type TEXT NOT NULL, -- initial, update or new_families
    mgnify_proteins_release TEXT NOT NULL, -- YYYY_MM
    pipeline_version TEXT,
    n_families INTEGER,
    n_updated INTEGER,
    n_not_updated INTEGER
);

-- Metadata of each release this DB holds: its FTP release_manifest.json flattened to dotted keys (bin/load_release_manifest.py)
CREATE TABLE release_info (
    release TEXT NOT NULL REFERENCES release_history(release),
    key TEXT NOT NULL, -- e.g. databases.pfam, databases.foldseek.pdb.pdb_date, pipeline.version
    value TEXT, -- strings as is; numbers, booleans and lists as JSON
    PRIMARY KEY (release, key)
);

-- Clans of the release the DB holds (FTP clans.tsv.gz; bin/load_clans.py): one row per family in a clan
CREATE TABLE mgnifam_clans (
    mgnifam_id INTEGER PRIMARY KEY REFERENCES mgnifam(id),
    clan_id TEXT NOT NULL, -- <release>_clan_<n>, numbered by size; not stable across releases
    is_representative INTEGER NOT NULL -- 1 for one family per clan
);

-- Similar family pairs of that release (FTP clan_edges.tsv.gz), family_1 < family_2 as text
CREATE TABLE mgnifam_clan_edges (
    family_1 INTEGER NOT NULL REFERENCES mgnifam(id),
    family_2 INTEGER NOT NULL REFERENCES mgnifam(id),
    shared_proteins INTEGER,
    protein_jaccard REAL,
    residue_jaccard REAL,
    residue_containment REAL,
    PRIMARY KEY (family_1, family_2)
);
