nextflow_process {

    name "Test Process TRUNCATE_A3M"
    script "../main.nf"
    process "TRUNCATE_A3M"

    tag "modules"
    tag "modules_local"
    tag "truncate_a3m"

    test("a3m - 5 records, max 3") {

        when {
            process {
                """
                input[0] = channel.of([ [ id:'42' ], file("${moduleDir}/tests/fixtures/42.a3m.gz", checkIfExists: true) ])
                input[1] = 3
                """
            }
        }

        then {
            def a3m = path(process.out.a3m[0][1])
            assertAll(
                { assert process.success },
                { assert a3m.fileName.toString() == "42.a3m.gz" },
                { assert a3m.linesGzip == ['>rep', 'MKVLAAGIVG', '>r1', 'MKVLaAGIVG', '>r2', '-KVLAAGIV-'] }
            )
        }
    }

    test("a3m - max above record count") {

        when {
            process {
                """
                input[0] = channel.of([ [ id:'42' ], file("${moduleDir}/tests/fixtures/42.a3m.gz", checkIfExists: true) ])
                input[1] = 10
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.a3m[0][1]).linesGzip == path("${moduleDir}/tests/fixtures/42.a3m.gz").linesGzip }
            )
        }
    }

    test("a3m - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([ [ id:'42' ], file("${moduleDir}/tests/fixtures/42.a3m.gz", checkIfExists: true) ])
                input[1] = 3
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.a3m[0][1]).fileName.toString() == "42.a3m.gz" }
            )
        }
    }
}
