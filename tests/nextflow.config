/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/proteinfamilies/'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

// Machine-specific database paths (pfam_path, funfams_path, hhdb_path, esmfold_db, esmfold_params_path,
// foldseek_db_path, ...) from a config outside the repo: MGNIFAMS_TEST_CONFIG=/abs/path/local.config nf-test test ...
includeConfig env('MGNIFAMS_TEST_CONFIG') ?: '/dev/null'
