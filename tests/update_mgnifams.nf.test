nextflow_pipeline {

    name "Test pipeline --mode update_mgnifams"
    script "../main.nf"
    tag "pipeline"
    tag "update_mgnifams"
    profile "test_update_mgnifams"

    // Needs the external databases (pfam_path, funfams_path, esmfold_db, esmfold_params_path, foldseek_db_path)
    // from local config, to be temporarily put in the test_update_mgnifams profile
    test("-profile test_update_mgnifams") {

        when {
            params {
                outdir = "$outputDir"
            }
        }


        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // paths to check for sizes
            def families_path           = "/update_families"
            def stable_families_size    = getAllFilesFromDir(params.outdir + families_path, ignoreFile: 'tests/.nftignore')
            def annotations_path        = "/annotation"
            def stable_annotations_size = getAllFilesFromDir(params.outdir + annotations_path, ignoreFile: 'tests/.nftignore')
            def table_data_path         = "/table_data"
            def stable_table_data_size  = getAllFilesFromDir(params.outdir + table_data_path, ignoreFile: 'tests/.nftignore')

            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_pipeline_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // Rest of the folders, counting result files because names can be mixed
                    families_path    + ": " + stable_families_size.size(),
                    annotations_path + ": " + stable_annotations_size.size(),
                    table_data_path  + ": " + stable_table_data_size.size()
                ).match() }
            )
        }
    }

    // Stub runs (no external tools): the not-updated re-annotation hook, with and without not_updated families
    def stubSamplesheet = { String outputDir, String root, String families ->
        def d  = "${root}/assets/data"
        def fx = "${root}/tests/data/annotate_not_updated"
        families = "${root}/${families}"
        def ss = new File("${outputDir}/samplesheet.csv"); ss.parentFile.mkdirs()
        ss.text = "sample,mgnify_proteins_sequences,mgnify_proteins_clusters,mgnify_proteins_pfam,mgnifams_hmms,mgnifams_families,reps_fasta,structures\n" +
            "mgnifams_update_test,${d}/mgy_protein_sequences.parquet,${d}/mgy_clusters.parquet,${d}/mgy_proteins_pfam.parquet,${d}/mgnifams_hmm.lib.gz,${families},${fx}/family_ids.fasta,${fx}/pdb\n"
        ss.toString()
    }

    test("-profile test_update_mgnifams -stub, reannotate") {
        tag "stub"
        options "-stub"

        when {
            params {
                outdir              = "$outputDir"
                input               = stubSamplesheet("$outputDir", "${projectDir}", "tests/data/annotate_not_updated/families.tsv.gz")
                esmfold_db          = "$outputDir"
                esmfold_params_path = "$outputDir"
            }
        }

        then {
            def base = "${params.outdir}/annotate_not_updated/update_families"
            assertAll(
                { assert workflow.success },
                { assert path("${base}/family_ids.fasta").readLines().findAll { l -> l.startsWith('>') } == ['>2', '>3'] },
                { assert 'annotation_only,true' in path("${base}/update_info.csv").readLines() },
                { assert 'hmmsearch_z,3' in path("${base}/update_info.csv").readLines() }
            )
        }
    }

    test("-profile test_update_mgnifams -stub, reannotate_none") {
        tag "stub"
        options "-stub"

        when {
            params {
                outdir              = "$outputDir"
                input               = stubSamplesheet("$outputDir", "${projectDir}", "assets/data/mgnifams_families.tsv.gz")
                esmfold_db          = "$outputDir"
                esmfold_params_path = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // collectFile storeDir creates its folders up front: no file may be published there
                { def dir = new File("${params.outdir}/annotate_not_updated"); def files = []
                    if (dir.exists()) { dir.eachFileRecurse(groovy.io.FileType.FILES) { f -> files << f.name } }
                    assert files == [] }
            )
        }
    }
}
