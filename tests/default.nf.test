nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // Needs the external databases (pfam_path, funfams_path, esmfold_db, esmfold_params_path, foldseek_db_path)
    // from a local config: see tests/nextflow.config
    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // paths to check for sizes
            def structures_path         = "/structures"
            def stable_structures_size  = getAllFilesFromDir(params.outdir + structures_path, ignoreFile: 'tests/.nftignore')
            def clusters_path           = "/setup_clusters"
            def stable_clusters_size    = getAllFilesFromDir(params.outdir + clusters_path, ignoreFile: 'tests/.nftignore')
            def families_path           = "/generate_families"
            def stable_families_size    = getAllFilesFromDir(params.outdir + families_path, ignoreFile: 'tests/.nftignore')
            def annotations_path        = "/annotation"
            def stable_annotations_size = getAllFilesFromDir(params.outdir + annotations_path, ignoreFile: 'tests/.nftignore')
            def table_data_path         = "/table_data"
            def stable_table_data_size  = getAllFilesFromDir(params.outdir + table_data_path, ignoreFile: 'tests/.nftignore')

            // Every family has a domain and a biome file; families.tsv.gz ids and -Z from starting_id
            def families   = path("${params.outdir}/generate_families/families/family_ids.fasta").readLines().findAll { l -> l.startsWith('>') }.collect { l -> l.substring(1) }
            def domain_ids = new File("${params.outdir}/domain_results").list().collect { n -> n.tokenize('.')[0] }.sort()
            def biome_ids  = new File("${params.outdir}/biome_results").list().collect { n -> n.tokenize('.')[0] }.sort()
            def info       = path("${params.outdir}/generate_families/update_info.csv").readLines()
            def tsv_ids    = path("${params.outdir}/generate_families/families.tsv.gz").linesGzip.drop(1).collect { l -> l.tokenize('\t')[0] }

            assertAll(
                { assert workflow.success},
                { assert domain_ids == families.sort() },
                { assert biome_ids == families.sort() },
                { assert tsv_ids.sort() == families.sort() },
                // conf/test.config starting_id = 1
                { assert tsv_ids.collect { id -> id as int }.min() == 1 },
                { assert "hmmsearch_z,${families.size()}".toString() in info },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_pipeline_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // Rest of the folders, counting result files because names can be mixed
                    structures_path  + ": " + stable_structures_size.size(),
                    clusters_path    + ": " + stable_clusters_size.size(),
                    families_path    + ": " + stable_families_size.size(),
                    annotations_path + ": " + stable_annotations_size.size(),
                    table_data_path  + ": " + stable_table_data_size.size()
                ).match() }
            )
        }
    }
}
