/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'PIGZ_UNCOMPRESS' {
        publishDir = [
            path: { "${params.outdir}/setup_clusters" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS' {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS_TO_MQC' {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_CREATEDB' {
        publishDir = [
            path: { "${params.outdir}/setup_clusters/mmseqs" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_LINCLUST' {
        // Differs from the MMSEQS_CREATEDB output dir (meta.id), which the module refuses to overwrite
        ext.prefix = { "${meta.id}_linclust" }
        ext.args = [
            "--min-seq-id ${params.linclust_seq_identity}",
            "-c ${params.linclust_coverage}",
            "--cov-mode ${params.linclust_cov_mode}",
            "--remove-tmp-files 1 -v 0"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/setup_clusters/mmseqs" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MMSEQS_CREATETSV' {
        publishDir = [
            path: { "${params.outdir}/setup_clusters/mmseqs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CALCULATE_CLUSTER_DISTRIBUTION'{
        publishDir = [
            path: { "${params.outdir}/setup_clusters" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_UNIQUE_CLUSTER_REPS'{
        publishDir = [
            path: { "${params.outdir}/setup_clusters" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHUNK_CLUSTERS' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/setup_clusters/chunks" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Family names stay <chunk>_<n>: the chunk is mgnifam's --chunk_id
    withName: 'MGNIFAM_GENERATEFAMILIES' {
        ext.prefix = { "${meta.chunk}" }
        ext.args   = { [
            "--discard_min_rep_length ${params.mgnifams_discard_min_rep_length}",
            "--discard_max_rep_length ${params.mgnifams_discard_max_rep_length}",
            "--discard_min_starting_membership ${params.mgnifams_discard_min_starting_membership}",
            "--max_seq_identity ${params.mgnifams_max_seq_identity}",
            "--max_seed_seqs ${params.mgnifams_max_seed_seqs}",
            "--max_gap_occupancy ${params.mgnifams_max_gap_occupancy}",
            "--recruit_evalue_cutoff ${params.mgnifams_recruit_evalue_cutoff}",
            "--recruit_hit_length_percentage ${params.mgnifams_recruit_hit_length_percentage}"
        ].join(' ') }
        tag = { "${meta.id}_${meta.chunk}" }
        maxForks = 30
        publishDir = [
            path: { "${params.outdir}/generate_families/pre_redundant/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // UPDATE_MGNIFAMS: update_families
    withName: 'EXTRACT_UNANNOTATED_PARQUET_SLICES|SPLIT_HMM_LIB|HMMER_ESLSFETCHINDEX' {
        publishDir = [
            path: { "${params.outdir}/update_families" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    // esl-sfetch --index shells out to GNU sort for large indexes, which spills to $TMPDIR.
    // GNU sort sizes its buffer from node RAM, not the SLURM limit: ulimit -v caps it at half the task memory
    withName: 'HMMER_ESLSFETCHINDEX' {
        beforeScript = { "export TMPDIR=\$PWD; ulimit -v ${task.memory.toKilo()}" }
    }

    withName: 'MGNIFAM_UPDATEFAMILIES' {
        ext.prefix = { "chunk_${meta.chunk}" }
        ext.args   = { [
            "--skip_refine",
            "--discard_min_rep_length ${params.mgnifams_discard_min_rep_length}",
            "--discard_max_rep_length ${params.mgnifams_discard_max_rep_length}",
            "--recruit_evalue_cutoff ${params.mgnifams_recruit_evalue_cutoff}",
            "--recruit_hit_length_percentage ${params.mgnifams_recruit_hit_length_percentage}"
        ].join(' ') }
        tag = { "${meta.id}_${meta.chunk}" }
        // Full MSAs flat (ids are unique across chunks); POOL_UPDATED_FAMILIES publishes the pooled delta/discarded CSVs
        publishDir = [
            path: { "${params.outdir}/update_families/full_msa" },
            mode: params.publish_dir_mode,
            pattern: "chunk_*/full_msa/*.sto.gz",
            saveAs: { filename -> filename.tokenize('/').last() }
        ]
    }

    withName: 'POOL_UPDATED_FAMILIES' {
        publishDir = [
            path: { "${params.outdir}/update_families" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXPORT_FAMILIES_TSV' {
        publishDir = [
            path: { "${params.outdir}/update_families" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POOL_PREREDUNDANT_FAMILIES_TSV' {
        publishDir = [
            path: { "${params.outdir}/remove_redundancy/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Redundancy edges: every pair at or above the residue threshold (plus containment-only pairs the selector skips)
    withName: '.*:REMOVE_REDUNDANCY:MGNIFAM_COMPUTECLANS' {
        ext.prefix = 'pre_redundant'
        ext.args   = { "--min_edge_jaccard ${params.redundant_residue_threshold} --min_edge_containment 1" }
        publishDir = [
            path: { "${params.outdir}/remove_redundancy/" },
            mode: params.publish_dir_mode,
            pattern: "pre_redundant/*.{log,json}",
            saveAs: { filename -> filename.tokenize('/').last() }
        ]
    }

    withName: 'SELECT_NONREDUNDANT_FAMILIES' {
        ext.prefix = 'pre_redundant'
        publishDir = [
            path: { "${params.outdir}/remove_redundancy/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // The release's clans (mgnifam defaults), named by release; FORMAT_CLANS publishes the FTP files
    withName: '.*:GENERATE_NONREDUNDANT_FAMILIES:MGNIFAM_COMPUTECLANS' {
        ext.prefix = { "${params.mgnifams_release}" }
        publishDir = [
            path: { "${params.outdir}/generate_families/clans/" },
            mode: params.publish_dir_mode,
            pattern: "*/*.{log,json}",
            saveAs: { filename -> filename.tokenize('/').last() }
        ]
    }

    withName: 'FORMAT_CLANS' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POOL_NONREDUNDANT_FAMILIES' {
        publishDir = [
            path: { "${params.outdir}/generate_families/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'REFORMAT_SEED_MSA' {
        ext.prefix = { "${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/generate_families/families/seed_msa/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'REFORMAT_FULL_MSA' {
        ext.prefix = { "${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/generate_families/families/full_msa/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PRESENT_DISCARDED_FAMILIES' {
        publishDir = [
            path: { "${params.outdir}/generate_families/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PRESENT_FAMILY_METADATA' {
        publishDir = [
            path: { "${params.outdir}/generate_families/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ARIA2' {
        publishDir = [
            path: { "${params.outdir}/structures/downloaded_dbs/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RUN_ESMFOLD' {
        ext.args = { params.use_gpu ? '' : '--cpu-only' }
        ext.prefix = { "${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            [
                path: { "${params.outdir}/structures/esmfold/pdb/" },
                mode: params.publish_dir_mode,
                pattern: '*.pdb'
            ],
            [
                path: { "${params.outdir}/structures/esmfold/scores/" },
                mode: params.publish_dir_mode,
                pattern: '*.txt'
            ]
        ]
    }

    withName: 'EXTRACT_CUDA_FAILED' {
        publishDir = [
            path: { "${params.outdir}/structures/esmfold/cuda_failed/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RUN_ESMFOLD_CPU' {
        ext.args = "--cpu-only"
        ext.prefix = { "${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            [
                path: { "${params.outdir}/structures/esmfold/pdb/" },
                mode: params.publish_dir_mode,
                pattern: '*.pdb'
            ],
            [
                path: { "${params.outdir}/structures/esmfold/scores/" },
                mode: params.publish_dir_mode,
                pattern: '*.txt'
            ]
        ]
    }

    withName: 'EXTRACT_ESMFOLD_SCORES' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/structures/esmfold/scores/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PARSE_CIF' {
        ext.prefix = { "${meta.id}_${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/structures/esmfold/cif/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // annotate_not_updated / update_mgnifams: processes under ANNOTATE_FAMILY_SUBSET publish below annotate_not_updated/
    withName: 'SELECT_FAMILY_SUBSET' {
        publishDir = [ enabled: false ] // ANNOTATE_FAMILY_SUBSET writes the selected reps to update_families/
    }

    withName: 'S4PRED_RUNMODEL' {
        ext.prefix = { "horiz_${meta.chunk}" }
        ext.args   = { "--outfmt horiz" }
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/annotation/reps/s4pred/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PARSE_S4PRED_TO_FEATURE_VIEWER' {
        ext.prefix = { "json" }
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/annotation/reps/s4pred/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEEPTMHMM_PREDICT' {
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/annotation/reps/deeptmhmm/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PARSE_TM_TO_FEATURE_VIEWER' {
        ext.prefix = { "json" }
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/annotation/reps/deeptmhmm/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ANNOTATE_REPS:HMMER_HMMSEARCH_PFAM' {
        // -Z: the release's family count (meta.z), so E-values share one base whatever subset of reps is searched
        ext.args   = { "-E ${params.hmmsearch_evalue_cutoff}" + (meta.z ? " -Z ${meta.z}" : '') }
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/annotation/reps/pfam/" },
            mode: params.publish_dir_mode,
            pattern: "*.domtbl.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ANNOTATE_REPS:HMMER_HMMSEARCH_FUNFAMS' {
        // -Z: the release's family count (meta.z), so E-values share one base whatever subset of reps is searched
        ext.args   = { "-E ${params.hmmsearch_evalue_cutoff}" + (meta.z ? " -Z ${meta.z}" : '') }
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/annotation/reps/funfams/" },
            mode: params.publish_dir_mode,
            pattern: "*.domtbl.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HHSUITE_REFORMAT' {
        ext.prefix = { "${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/annotation/models/reformat/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // UPDATE_MGNIFAMS optional AlphaFold2 branch; after HHSUITE_REFORMAT, which the alias also matches
    withName: 'REFORMAT_FULL_MSA_A3M' {
        ext.args = '-M first'
        ext.prefix = { "${meta.id}" }
        tag = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }

    withName: 'TRUNCATE_A3M' {
        publishDir = [ enabled: false ]
    }

    withName: 'COLABFOLD_BATCH_MSA' {
        publishDir = [
            path: { "${params.outdir}/structures/alphafold2/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HHSUITE_HHBLITS' {
        ext.args = [
            "-z ${params.hh_min_reported}",
            "-Z ${params.hh_max_reported}",
            "-p ${params.hh_probability_threshold}",
            "-E ${params.hh_evalue_cutoff}",
            "-hide_cons -hide_pred"
        ].join(' ').trim()
        ext.prefix = { "${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/annotation/models/hhblits/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HHSUITE_HHSEARCH' {
        ext.args = [
            "-z ${params.hh_min_reported}",
            "-Z ${params.hh_max_reported}",
            "-p ${params.hh_probability_threshold}",
            "-E ${params.hh_evalue_cutoff}",
            "-hide_cons -hide_pred"
        ].join(' ').trim()
        ext.prefix = { "${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}/annotation/models/hhsearch/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FOLDSEEK_EASYSEARCH' {
        ext.args = "-e ${params.foldseek_evalue_cutoff} --format-output query,target,fident,alnlen,mismatch,gapopen,qstart,qend,tstart,tend,evalue,bits,alntmscore,qtmscore,ttmscore --format-mode 4"
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/annotation/structures/foldseek/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'EXPORT_MGNIFAMS' {
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/table_data/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_EXPORT_PFAMS' {
        ext.prefix = { "pfam" }
        ext.max_evalue = { params.hmmsearch_evalue_cutoff } // hmmsearch -E only filters whole sequences
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/table_data/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_EXPORT_FUNFAMS' {
        ext.prefix = { "funfam" }
        ext.max_evalue = { params.hmmsearch_evalue_cutoff } // hmmsearch -E only filters whole sequences
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/table_data/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXPORT_MODEL_PFAMS' {
        ext.prefix = { "${meta.chunk}" }
        tag = { "${meta.id}_${meta.chunk}" }
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/table_data/" },
            mode: params.publish_dir_mode,
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXPORT_FOLDS' {
        publishDir = [
            path: { "${params.outdir}${task.process.contains(':ANNOTATE_FAMILY_SUBSET:') ? '/annotate_not_updated' : ''}/table_data/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Intermediate DBs; only the finished DB is published (FINALIZE_SQLITE, UPDATE_SQLITE_BLOBS_STAGED)
    withName: 'INIT_SQLITE|IMPORT_QUERIES' {
        publishDir = [ enabled: false ]
    }

    withName: 'FINALIZE_SQLITE' {
        publishDir = [
            path: { "${params.outdir}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:POST_UPDATE_MGNIFAMS_UPDATE_DB:IMPORT_QUERIES' {
        // Always produced (header-only without hits): the merge replaces these child tables
        ext.args = 'mgnifam_pfams.csv mgnifam_funfams.csv mgnifam_folds.csv'
    }

    withName: 'SPLIT_FAMILY_MEMBERS' {
        publishDir = [ enabled: false ]
    }

    withName: 'BUILD_PARQUET_DOMAIN_QUERIES|BUILD_PARQUET_BIOME_QUERIES' {
        publishDir = [
            path: { "${params.outdir}/update_families" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'UPDATE_SQLITE_BLOBS_STAGED' {
        publishDir = [
            path: { "${params.outdir}/db" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUERY_MGNPROTEIN_DB' {
        publishDir = [
            path: { "${params.outdir}/mgnprotein_db_query/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PARSE_BIOMES' {
        publishDir = [
            path: { "${params.outdir}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PARSE_DOMAINS' {
        publishDir = [
            path: { "${params.outdir}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'UPDATE_SQLITE_BLOBS' {
        publishDir = [
            path: { "${params.outdir}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
