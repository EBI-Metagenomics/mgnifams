/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running local tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Rebuilds the biomes of families 2 and 4 (tests/fixtures/rebuild_biomes/refined_families.tsv,
    from an update_mgnifams test run) from the test clusters parquet; needs no external databases.

    Use as follows:
        nextflow run ebi-metagenomics/mgnifams -profile test_rebuild_biomes,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {

    // Input options
    input = "${projectDir}/assets/samplesheets/samplesheet_rebuild_biomes.csv"
    mode  = 'rebuild_biomes'

    // One family per lookup task and per PARSE_BIOMES task
    family_query_chunks = 2
    query_result_chunks = 1

    // Required by the schema, unused by this mode
    pfam_path        = 'unused'
    funfams_path     = 'unused'
    foldseek_db_path = 'unused'

    // Boilerplate options
    outdir = "${launchDir}/output_rebuild_biomes"

}
