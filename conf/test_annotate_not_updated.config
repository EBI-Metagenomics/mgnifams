/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running local tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Re-annotates families 2 and 3 (not_updated in tests/fixtures/annotate_not_updated/families.tsv.gz)
    from their reps and ESMFold PDBs. External databases (pfam_path, funfams_path,
    foldseek_db_path) come from your local config.
    Use as follows:
        nextflow run ebi-metagenomics/mgnifams -profile test_annotate_not_updated,<docker/singularity>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    input = "${projectDir}/assets/samplesheets/samplesheet_annotate_not_updated.csv"
    mode  = 'annotate_not_updated'

    foldseek_evalue_cutoff = 30
    foldseek_alphafold_db  = 'alphafold'
    outdir = "${launchDir}/output_annotate_not_updated"
}
