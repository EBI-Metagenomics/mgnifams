/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running local tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Builds the delta DB from tests/fixtures/update_results, a two-family update_mgnifams
    outdir; needs no external databases.

    Use as follows:
        nextflow run ebi-metagenomics/mgnifams -profile test_post_update_mgnifams_update_db,<docker/singularity>

----------------------------------------------------------------------------------------
*/

params {

    // Input options
    input = "${projectDir}/assets/samplesheets/samplesheet_post_update_mgnifams_update_db.csv"
    mode  = 'post_update_mgnifams_update_db'

    // Date of the release, as the FTP RELEASES.tsv (release_history on merge)
    release_date = '2026-11-02'

    // Boilerplate options
    outdir = "${launchDir}/output_post_update_db"

}
